{%- comment -%}
  Store logo shown on top of product photos (cards and product gallery), so every
  product image — including ones added later — carries the brand. The original image
  file in Shopify is not changed; the logo is layered on by the theme.
  Accepts:
  - context: {String} 'card' (default), 'gallery' or 'thumb' (small cart / search thumbnails)
{%- endcomment -%}
{%- if settings.watermark_enable -%}
  {%- liquid
    assign wm_context = context | default: 'card'
    assign wm_sizes = '84px'
    assign wm_widths = '130, 260, 520'
    assign wm_width = 520
    if wm_context == 'gallery'
      assign wm_sizes = '112px'
    elsif wm_context == 'thumb'
      assign wm_sizes = '34px'
      assign wm_widths = '34, 68, 102'
      assign wm_width = 102
    endif
    if settings.watermark_position == 'center'
      assign wm_sizes = '260px'
    endif
    assign wm_image = settings.watermark_image | default: settings.logo
  -%}
  <span
    class="watermark watermark--{{ wm_context }} watermark--{{ settings.watermark_position | default: 'bottom_right' }}{% if settings.watermark_chip %} watermark--chip{% endif %}"
    aria-hidden="true"
  >
    {%- if wm_image != blank -%}
      {{
        wm_image
        | image_url: width: wm_width
        | image_tag: alt: '', loading: 'lazy', widths: wm_widths, sizes: wm_sizes, draggable: 'false'
      }}
    {%- else -%}
      <img
        src="{{ 'anjum-mart-logo.png' | asset_img_url: '260x' }}"
        srcset="{{ 'anjum-mart-logo.png' | asset_img_url: '130x' }} 130w, {{ 'anjum-mart-logo.png' | asset_img_url: '260x' }} 260w, {{ 'anjum-mart-logo.png' | asset_url }} 360w"
        sizes="{{ wm_sizes }}"
        alt=""
        width="360"
        height="358"
        loading="lazy"
        decoding="async"
        draggable="false"
      >
    {%- endif -%}
  </span>
{%- endif -%}
