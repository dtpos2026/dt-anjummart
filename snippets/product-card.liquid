{%- comment -%}
  Product card used in grids, rails, search results and recommendations.
  Accepts:
  - product: {Object} product (omit and pass placeholder: true for theme editor placeholders)
  - placeholder: {Boolean} render a theme-editor placeholder card
  - placeholder_index: {Number} 1-6, which placeholder illustration to use
  - sizes: {String} image sizes attribute
  - lazy: {Boolean} lazy-load images (default true)
  - section_id: {String} used to build unique form ids
{%- endcomment -%}
{%- liquid
  assign img_sizes = sizes | default: '(min-width: 1320px) 300px, (min-width: 990px) calc((100vw - 140px) / 4), (min-width: 750px) calc((100vw - 90px) / 3), calc((100vw - 44px) / 2)'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}

{%- if placeholder -%}
  {%- assign ph = placeholder_index | default: 1 | modulo: 6 | plus: 1 -%}
  <div class="product-card">
    <div class="product-card__media">
      {{ 'product-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="product-card__info">
      <h3 class="product-card__title">Product title</h3>
      <div class="product-card__meta">
        <div class="price"><span class="price-item price-item--regular">{{ 2500000 | money }}</span></div>
      </div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign cheapest = product.variants | sort: 'price' | first
    assign sale_compare_at = cheapest.compare_at_price | default: 0
    assign on_sale = false
    if sale_compare_at > product.price
      assign on_sale = true
    endif
    assign card_alt = product.featured_media.alt | default: product.title
    assign card_label = product.type
    if product.tags contains 'mens-watches'
      assign card_label = 'products.product.label_mens_watch' | t
    elsif product.tags contains 'womens-watches'
      assign card_label = 'products.product.label_womens_watch' | t
    elsif product.tags contains 'necklace-set'
      assign card_label = 'products.product.label_jewellery_set' | t
    endif
    assign quick_form_id = 'quick-add-' | append: section_id | append: '-' | append: product.id
    assign second_media = nil
    if settings.card_show_second_image and product.media.size > 1
      assign second_media = product.media[1]
      if second_media.media_type != 'image'
        assign second_media = second_media.preview_image
      endif
    endif
  -%}
  <div class="product-card" data-product-card>
    <div class="product-card__figure">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: loading,
            sizes: img_sizes,
            widths: '240, 320, 400, 500, 600, 700, 800, 900',
            alt: card_alt,
            class: 'product-card__image product-card__image--primary'
        }}
        {%- if second_media -%}
          {{
            second_media
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              sizes: img_sizes,
              widths: '240, 320, 400, 500, 600, 700, 800, 900',
              alt: '',
              class: 'product-card__image product-card__image--secondary'
          }}
        {%- endif -%}
        {% render 'image-watermark', context: 'card' %}
      {%- else -%}
        <div class="product-card__noimage">
          {% render 'icon', name: 'sparkle' %}
          <span>{{ 'products.product.no_image' | t }}</span>
        </div>
      {%- endif -%}

      <div class="product-card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif on_sale -%}
          {%- if settings.card_show_discount_percent and product.price_varies == false -%}
            {%- assign percent = sale_compare_at | minus: product.price | times: 100.0 | divided_by: sale_compare_at | round -%}
            <span class="badge badge--sale">{{ 'products.product.percent_off' | t: percent: percent }}</span>
          {%- else -%}
            <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>

    <div class="product-card__hoverbar">
      <button
        type="button"
        class="product-card__hoverbtn"
        data-quick-view
        data-quick-view-url="{{ product.url }}"
        aria-haspopup="dialog"
        aria-label="{{ 'products.product.quick_view_for' | t: title: product.title }}"
      >
        {{- 'products.product.quick_view' | t -}}
      </button>
    </div>
    </div>

    <div class="product-card__info">
      {%- if card_label != blank -%}
        <span class="product-card__label">{{ card_label | escape }}</span>
      {%- endif -%}
      {%- if settings.card_show_vendor and product.vendor != blank -%}
        <span class="product-card__vendor">{{ product.vendor }}</span>
      {%- endif -%}

      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>

      {%- unless product.has_only_default_variant -%}
        {%- assign first_option = product.options_with_values.first -%}
        {%- if first_option.values.size > 1 -%}
          <p class="product-card__options">
            {{ first_option.name | escape }}:
            {% for value in first_option.values limit: 3 -%}
              {{- value | escape }}{% unless forloop.last %}, {% endunless -%}
            {%- endfor -%}
            {%- if first_option.values.size > 3 -%}
              {%- assign extra_values = first_option.values.size | minus: 3 %}
              {{ 'products.product.options_more' | t: count: extra_values -}}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endunless -%}

      <div class="product-card__meta">
        {% render 'price', product: product %}
        {%- if variant.available and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 -%}
          <span class="stock stock--in">{{ 'products.product.in_stock' | t }}</span>
        {%- endif -%}
      </div>

      {%- if settings.card_show_quick_add -%}
        <div class="product-card__action">
          {%- if product.available == false -%}
            <button type="button" class="button button--full" disabled>
              {{- 'products.product.sold_out' | t -}}
            </button>
          {%- elsif product.has_only_default_variant -%}
            {%- form 'product', product, id: quick_form_id, data-product-form: '', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" class="button button--full" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">
                {{- 'products.product.add_to_cart' | t -}}
              </button>
            {%- endform -%}
          {%- else -%}
            <a class="button button--full" href="{{ product.url }}" aria-label="{{ 'products.product.choose_options' | t }}: {{ product.title | escape }}">
              {{- 'products.product.choose_options' | t -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
