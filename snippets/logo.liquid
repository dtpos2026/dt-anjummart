{%- comment -%}
  Renders the official Anjum Mart logo (or the logo override from theme settings).
  Accepts:
  - height: {Number} rendered height in px (used for width/height attributes)
  - lazy: {Boolean} lazy-load (default false)
  - class: {String} optional class
  - on_dark: {Boolean} use the white/gold version on dark backgrounds
{%- endcomment -%}
{%- liquid
  assign logo_h = height | default: 72
  assign loading = 'eager'
  if lazy
    assign loading = 'lazy'
  endif
  assign logo_file = 'anjum-mart-logo.png'
  if on_dark
    assign logo_file = 'anjum-mart-logo-dark.png'
  endif
-%}
{%- if settings.logo != blank -%}
  {%- assign logo_w = logo_h | times: settings.logo.aspect_ratio | round -%}
  {%- assign logo_w2 = logo_w | times: 2 -%}
  {{
    settings.logo
    | image_url: width: logo_w2
    | image_tag: alt: shop.name, width: logo_w, height: logo_h, loading: loading, class: class
  }}
{%- else -%}
  {%- liquid
    assign s1 = logo_h | append: 'x'
    assign s2 = logo_h | times: 2 | append: 'x'
    assign s3 = logo_h | times: 3 | append: 'x'
  -%}
  <img
    src="{{ logo_file | asset_img_url: s2 }}"
    srcset="{{ logo_file | asset_img_url: s1 }} 1x, {{ logo_file | asset_img_url: s2 }} 2x, {{ logo_file | asset_img_url: s3 }} 3x"
    alt="{{ shop.name | escape }}"
    width="{{ logo_h }}"
    height="{{ logo_h }}"
    loading="{{ loading }}"
    {% if class %}
      class="{{ class }}"
    {% endif %}
  >
{%- endif -%}
