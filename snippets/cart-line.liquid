{%- comment -%}
  A single cart line, shared by the cart drawer and the cart page.
  Accepts:
  - item: {Object} line item
  - line: {Number} 1-based line index
  - id_prefix: {String} unique prefix for element ids
{%- endcomment -%}
{%- liquid
  assign max_qty = ''
  if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' and item.variant.inventory_quantity > 0
    assign max_qty = item.variant.inventory_quantity
  endif
-%}
<li class="cart-item" data-cart-item>
  <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 240
        | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '84px', alt: ''
      }}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

    {%- unless item.product.has_only_default_variant and item.properties.size == 0 and item.selling_plan_allocation == nil -%}
      <ul class="cart-item__options" role="list">
        {%- unless item.product.has_only_default_variant -%}
          {%- for option in item.options_with_values -%}
            <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
          {%- endfor -%}
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <li>
              {{ property.first | escape }}:
              {% if property.last contains '/uploads/' -%}
                <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>
              {%- else -%}
                {{- property.last | escape -}}
              {%- endif %}
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <li>{{ item.selling_plan_allocation.selling_plan.name | escape }}</li>
        {%- endif -%}
      </ul>
    {%- endunless -%}

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-item__discounts" role="list">
        {%- for discount in item.line_level_discount_allocations -%}
          <li>{% render 'icon', name: 'tag' %} {{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="price">
      {%- if item.original_line_price != item.final_line_price -%}
        <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
        <span class="price-item price-item--sale">{{ item.final_line_price | money }}</span>
        <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
        <s class="price-item price-item--compare">{{ item.original_line_price | money }}</s>
      {%- else -%}
        <span class="price-item price-item--regular">{{ item.final_line_price | money }}</span>
      {%- endif -%}
      {%- if item.unit_price_measurement -%}
        <span class="price__unit">
          {{- item.unit_price | money }} /
          {% if item.unit_price_measurement.reference_value != 1 -%}
            {{- item.unit_price_measurement.reference_value -}}
          {%- endif %}
          {{ item.unit_price_measurement.reference_unit }}
        </span>
      {%- endif -%}
    </div>

    <div class="cart-item__row">
      <div class="quantity quantity--small" data-quantity>
        <button type="button" class="quantity__button" data-qty-step="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}: {{ item.product.title | escape }}">
          {% render 'icon', name: 'minus' %}
        </button>
        <label class="visually-hidden" for="{{ id_prefix }}-qty-{{ line }}">{{ 'cart.quantity' | t }}: {{ item.product.title | escape }}</label>
        <input
          class="quantity__input"
          type="number"
          inputmode="numeric"
          id="{{ id_prefix }}-qty-{{ line }}"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          {% if max_qty != '' %}
            max="{{ max_qty }}"
          {% endif %}
          data-line="{{ line }}"
        >
        <button type="button" class="quantity__button" data-qty-step="1" aria-label="{{ 'products.product.increase_quantity' | t }}: {{ item.product.title | escape }}">
          {% render 'icon', name: 'plus' %}
        </button>
      </div>
      <a
        class="cart-item__remove"
        href="{{ item.url_to_remove }}"
        data-line-remove="{{ line }}"
        aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}"
      >
        {% render 'icon', name: 'trash' %}
      </a>
    </div>
    <p class="cart-item__error" data-line-error role="alert" hidden></p>
  </div>
</li>
