{%- comment -%}
  Renders a product price.
  Accepts:
  - product: {Object} product (required)
  - use_variant: {Boolean} use the selected/first available variant instead of the price range
  - show_badge: {Boolean} show the discount percentage badge
  - class: {String} extra classes
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
    assign price = target.price
    assign compare_at = target.compare_at_price
  else
    assign target = product
    assign price = product.price
    assign compare_at = product.compare_at_price
  endif

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif

  assign show_from = false
  unless use_variant
    if product.price_varies
      assign show_from = true
    endif
  endunless

  assign money_price = price | money
-%}
<div class="price{% if class %} {{ class }}{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span class="price-item price-item--sale">
      {%- if show_from -%}
        {{- 'products.product.price_from' | t: price: money_price -}}
      {%- else -%}
        {{- money_price -}}
      {%- endif -%}
    </span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price-item price-item--compare">{{ compare_at | money }}</s>
    {%- if show_badge -%}
      {%- assign percent = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round -%}
      {%- if percent > 0 -%}
        <span class="badge badge--sale">{{ 'products.product.percent_off' | t: percent: percent }}</span>
      {%- endif -%}
    {%- endif -%}
  {%- else -%}
    <span class="price-item price-item--regular">
      {%- if show_from -%}
        {{- 'products.product.price_from' | t: price: money_price -}}
      {%- else -%}
        {{- money_price -}}
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if use_variant and target.unit_price_measurement -%}
    <span class="price__unit">
      {{- target.unit_price | money }} /
      {% if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif %}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
