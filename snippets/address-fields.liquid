{%- comment -%}
  Address form fields for the classic customer addresses page.
  Accepts:
  - form: {Object} customer_address form
  - prefix: {String} unique id prefix
{%- endcomment -%}
<div class="contact-form__row">
  <div class="field">
    <label for="{{ prefix }}-first">{{ 'customer.addresses.first_name' | t }}</label>
    <input class="input" type="text" id="{{ prefix }}-first" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="field">
    <label for="{{ prefix }}-last">{{ 'customer.addresses.last_name' | t }}</label>
    <input class="input" type="text" id="{{ prefix }}-last" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="field">
  <label for="{{ prefix }}-company">{{ 'customer.addresses.company' | t }}</label>
  <input class="input" type="text" id="{{ prefix }}-company" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="field">
  <label for="{{ prefix }}-address1">{{ 'customer.addresses.address1' | t }}</label>
  <input class="input" type="text" id="{{ prefix }}-address1" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label for="{{ prefix }}-address2">{{ 'customer.addresses.address2' | t }}</label>
  <input class="input" type="text" id="{{ prefix }}-address2" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="contact-form__row">
  <div class="field">
    <label for="{{ prefix }}-city">{{ 'customer.addresses.city' | t }}</label>
    <input class="input" type="text" id="{{ prefix }}-city" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="field">
    <label for="{{ prefix }}-zip">{{ 'customer.addresses.zip' | t }}</label>
    <input class="input" type="text" id="{{ prefix }}-zip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
  </div>
</div>
<div class="contact-form__row">
  <div class="field">
    <label for="{{ prefix }}-country">{{ 'customer.addresses.country' | t }}</label>
    <div class="select-wrapper">
      <select class="select" id="{{ prefix }}-country" name="address[country]" autocomplete="country">
        {{ all_country_option_tags }}
      </select>
      {% render 'icon', name: 'chevron-down' %}
    </div>
  </div>
  <div class="field">
    <label for="{{ prefix }}-province">{{ 'customer.addresses.province' | t }}</label>
    <input class="input" type="text" id="{{ prefix }}-province" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
  </div>
</div>
<div class="field">
  <label for="{{ prefix }}-phone">{{ 'customer.addresses.phone' | t }}</label>
  <input class="input" type="tel" id="{{ prefix }}-phone" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<label class="checkbox field" for="{{ prefix }}-default">
  <input type="checkbox" id="{{ prefix }}-default" name="address[default]" value="1" {% if form.set_as_default_checkbox %}checked{% endif %}>
  {{ 'customer.addresses.set_default' | t }}
</label>
