{%- comment -%}
  Renders an inline SVG icon.
  Accepts:
  - name: {String} icon name
  - class: {String} optional extra class
{%- endcomment -%}
{%- capture cls %}icon icon-{{ name }}{% if class %} {{ class }}{% endif %}{% endcapture -%}
