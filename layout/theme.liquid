<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- liquid
      assign meta_description = page_description | default: settings.seo_default_description
    -%}
    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | strip_html | strip_newlines | escape }}">
    {%- endif -%}
    {%- if settings.google_site_verification != blank -%}
      {%- liquid
        assign google_code = settings.google_site_verification | strip
        if google_code contains 'content="'
          assign google_code = google_code | split: 'content="' | last | split: '"' | first
        endif
      -%}
      <meta name="google-site-verification" content="{{ google_code | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {%- unless settings.type_heading_font.system? -%}
      {%- if template.name == 'index' -%}
        {%- assign hero_font = settings.type_heading_font -%}
        {%- if hero_font -%}
          {{ hero_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
        {%- endif -%}
      {%- endif -%}
    {%- endunless -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.AnjumMart = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          inStock: {{ 'products.product.in_stock' | t | json }},
          lowStock: {{ 'products.product.low_stock' | t: count: '[count]' | json }},
          salePrice: {{ 'products.product.sale_price' | t | json }},
          regularPrice: {{ 'products.product.regular_price' | t | json }},
          percentOff: {{ 'products.product.percent_off' | t: percent: '[percent]' | json }},
          loading: {{ 'general.loading' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          genericError: {{ 'general.error' | t | json }},
          suggestions: {{ 'search.suggestions_count' | t | json }},
          removed: {{ 'cart.removed' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          subtotal: {{ 'cart.subtotal' | t | json }},
          addedToCart: {{ 'cart.added' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}"
    {% if settings.animations_enable %}
      data-animate
    {% endif %}
    {% if settings.animations_hover %}
      data-hover-effects
    {% endif %}
  >
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    <p id="A11yStatus" class="visually-hidden" role="status" aria-live="polite"></p>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    {%- liquid
      assign whatsapp_digits = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
    -%}
    {%- if whatsapp_digits != blank and settings.whatsapp_floating -%}
      <a
        class="whatsapp-float"
        href="https://wa.me/{{ whatsapp_digits }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}"
        target="_blank"
        rel="noopener"
        aria-label="{{ 'general.whatsapp' | t }} ({{ 'general.new_window' | t }})"
      >
        {% render 'icon', name: 'whatsapp' %}
      </a>
    {%- endif -%}

    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          {%- if settings.logo != blank -%}
            "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- else -%}
            "logo": {{ 'anjum-mart-logo.png' | asset_url | prepend: 'https:' | json }}
          {%- endif -%}
          {%- liquid
            assign same_as = ''
            assign social_keys = 'facebook,instagram,tiktok,youtube,pinterest,x' | split: ','
            for key in social_keys
              assign setting_key = 'social_' | append: key | append: '_link'
              assign link = settings[setting_key] | strip
              if link != blank
                unless link contains '://'
                  assign link = link | prepend: 'https://'
                endunless
                assign same_as = same_as | append: link | append: '|'
              endif
            endfor
            assign same_as_list = same_as | split: '|'
          -%}
          {%- if same_as_list.size > 0 -%},
          "sameAs": {{ same_as_list | json }}
          {%- endif %}
        }
      </script>
      {%- capture search_action_target -%}{{ request.origin }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ search_action_target | json }},
            "query-input": "required name=search_term_string"
          }
        }
      </script>
    {%- endif -%}
  </body>
</html>
