[
  {
    "name": "theme_info",
    "theme_name": "Anjum Mart",
    "theme_version": "1.0.0",
    "theme_author": "Anjum Mart",
    "theme_documentation_url": "https://github.com/dtpos2026/dt-anjummart",
    "theme_support_url": "https://github.com/dtpos2026/dt-anjummart/issues"
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo override",
        "info": "Leave empty to use the official Anjum Mart logo bundled with the theme."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Desktop logo height",
        "min": 40,
        "max": 110,
        "step": 2,
        "unit": "px",
        "default": 72
      },
      {
        "type": "range",
        "id": "logo_height_mobile",
        "label": "Mobile logo height",
        "min": 32,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 48
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon override",
        "info": "Leave empty to use the Anjum Mart emblem. Recommended size: 96 x 96 px."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (brand blue)",
        "default": "#124FA3"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (brand red)",
        "default": "#E31837"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success (brand green)",
        "default": "#139447"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#172033"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Light section background",
        "default": "#F5F8FC"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Headings",
        "default": "montserrat_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body text size",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (4:5)" },
          { "value": "tall", "label": "Tall (3:4)" }
        ],
        "default": "portrait"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Image fit",
        "options": [
          { "value": "cover", "label": "Fill frame" },
          { "value": "contain", "label": "Show whole image" }
        ],
        "default": "cover"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show Add to cart button",
        "info": "Products with a single variant are added directly. Products with options link to the product page.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_discount_percent",
        "label": "Show discount percentage on sale badge",
        "info": "Calculated from the product's real compare-at price.",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When a product is added",
        "options": [
          { "value": "drawer", "label": "Open cart drawer" },
          { "value": "page", "label": "Go to cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order notes",
        "default": false
      },
      {
        "type": "richtext",
        "id": "cart_info",
        "label": "Cart information text",
        "info": "Optional. Only add delivery or payment details you have confirmed in Shopify settings."
      }
    ]
  },
  {
    "name": "Store contact",
    "settings": [
      {
        "type": "paragraph",
        "content": "Contact details only appear on the storefront when they are filled in."
      },
      {
        "type": "checkbox",
        "id": "show_store_email",
        "label": "Show store email",
        "info": "Uses the customer-facing email from Settings > General unless an email is entered below.",
        "default": true
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email override"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Phone number",
        "info": "Shown as entered, e.g. +92 300 1234567"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "International format with country code, e.g. 923001234567. Leave empty to hide all WhatsApp links."
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "WhatsApp pre-filled message",
        "default": "Hello Anjum Mart, I have a question."
      },
      {
        "type": "checkbox",
        "id": "whatsapp_floating",
        "label": "Show floating WhatsApp button",
        "default": true
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Address"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Support hours",
        "info": "e.g. Mon–Sat, 10am–8pm"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Icons only appear for profiles you enter."
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/..."
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/..."
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@..."
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/..."
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://pinterest.com/..."
      },
      {
        "type": "text",
        "id": "social_x_link",
        "label": "X (Twitter)",
        "info": "https://x.com/..."
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Show search suggestions while typing",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_price",
        "label": "Show prices in suggestions",
        "default": true
      }
    ]
  },
  {
    "name": "Social sharing image",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default sharing image",
        "info": "Used when a page has no image of its own. Leave empty to use the Anjum Mart logo card."
      }
    ]
  }
]
