<div class="account-page">
  <div class="page-width account-page__narrow">
    <div class="card">
      <h1 class="h2">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.reset_password.subtext' | t }}</p>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input class="input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Reset password", "tag": "section", "class": "main-reset-password-section", "settings": [] }
{% endschema %}
