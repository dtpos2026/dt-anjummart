{%- comment -%}
  Two editorial tiles (e.g. For Him / For Her). Each links to all products with a product tag
  (/collections/all/<tag>) unless a link is set. Without an image, the first product photo with that tag is used.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="section gender-banners" aria-labelledby="GenderHeading-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section-header">
          <div class="section-header__text">
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            <h2 id="GenderHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          </div>
        </div>
      {%- else -%}
        <h2 class="visually-hidden" id="GenderHeading-{{ section.id }}">{{ 'general.shop_now' | t }}</h2>
      {%- endif -%}

      <ul class="gender-banners__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = block.settings.tag | strip | handleize
            assign link = block.settings.link
            if link == blank
              if tag != blank
                assign link = routes.all_products_collection_url | append: '/' | append: tag
              else
                assign link = routes.all_products_collection_url
              endif
            endif
            assign tile_image = block.settings.image
            if tile_image == blank and tag != blank
              for p in collections.all.products
                assign p_tags = p.tags | join: ',' | downcase | split: ','
                if p_tags contains tag and p.featured_media
                  assign tile_image = p.featured_media.preview_image
                  break
                endif
              endfor
            endif
          -%}
          <li class="gender-banner{% if tile_image == blank %} gender-banner--no-image{% endif %}" {{ block.shopify_attributes }}>
            <a class="gender-banner__link" href="{{ link }}">
              <div class="gender-banner__media">
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 1384px) 640px, (min-width: 750px) 50vw, 100vw',
                      alt: ''
                  }}
                {%- else -%}
                  <span class="gender-banner__fallback" aria-hidden="true"></span>
                {%- endif -%}
              </div>
              <div class="gender-banner__caption">
                <span class="gender-banner__title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="gender-banner__text">{{ block.settings.text | escape }}</span>
                {%- endif -%}
                <span class="gender-banner__cta">{{ block.settings.button_label | default: 'Shop now' | escape }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop for Him / Her",
  "tag": "div",
  "class": "gender-banners-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated edits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by style" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "For Him" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "info": "Products with this tag are shown, e.g. men or women.",
          "default": "men"
        },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Optional. Overrides the tag link." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Defaults to the first product photo with the tag." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop for Him / Her",
      "blocks": [
        { "type": "tile", "settings": { "title": "For Him", "tag": "men" } },
        { "type": "tile", "settings": { "title": "For Her", "tag": "women" } }
      ]
    }
  ]
}
{% endschema %}
