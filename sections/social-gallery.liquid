{{ 'home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ig = settings.social_instagram_link | strip
  assign handle = ''
  if ig != blank
    assign handle = ig | split: 'instagram.com/' | last | split: '/' | first | split: '?' | first
    unless ig contains '://'
      assign ig = ig | prepend: 'https://'
    endunless
  endif
  assign has_tiles = false
  for block in section.blocks
    if block.settings.image != blank
      assign has_tiles = true
      break
    endif
  endfor
-%}

{%- if has_tiles or request.design_mode -%}
  <section class="section social-gallery" aria-labelledby="SocialGallery-{{ section.id }}">
    <div class="page-width">
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="SocialGallery-{{ section.id }}">{{ section.settings.heading | default: 'Follow Anjum Mart' | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="section-header__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if has_tiles -%}
        <ul class="social-gallery__grid" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              {%- assign href = block.settings.link | default: ig -%}
              <li class="social-gallery__item" {{ block.shopify_attributes }}>
                {%- if href != blank -%}
                  <a class="social-gallery__link" href="{{ href }}"{% unless href contains request.host %} target="_blank" rel="noopener"{% endunless %}>
                    {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 200px, 33vw', alt: block.settings.alt }}
                  </a>
                {%- else -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 200px, 33vw', alt: block.settings.alt }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="social-gallery__empty">Add up to six pictures (blocks) from Instagram or the Anjum Mart posts.</p>
      {%- endif -%}

      {%- if ig != blank and section.settings.button_label != blank -%}
        <p class="social-gallery__cta">
          <a class="button button--secondary" href="{{ ig }}" target="_blank" rel="noopener">
            {% render 'icon', name: 'instagram' %}
            {{ section.settings.button_label | escape }}{% if handle != blank %} @{{ handle | escape }}{% endif %}
          </a>
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram gallery",
  "tag": "div",
  "class": "social-gallery-wrap",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Up to six pictures that link to your Instagram profile (set in Theme settings, Social media). Use real post pictures. The profile link comes from Theme settings."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "On Instagram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Anjum Mart"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New watches, jewellery and perfumes, shown the way you will wear them."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Picture",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "info": "Square or 4:5, at least 600 px wide."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Description for screen readers",
          "info": "Describe what the picture shows, for example: Gold men's watch with a black dial."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Empty: opens the Instagram profile."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
