<div class="password">
  <div class="brand-stripe" aria-hidden="true"></div>
  <div class="page-width page-width--narrow password__inner">
    <div class="password__logo">{% render 'logo', height: 140 %}</div>
    <h1 class="password__title">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_signup -%}
      <div class="card password__card">
        <h2 class="h4">{{ 'templates.password.signup_title' | t }}</h2>
        <p class="text-muted">{{ 'templates.password.signup_text' | t }}</p>
        {%- form 'customer', id: 'PasswordSignup' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password page">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">{{ 'templates.password.signup_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="password__row">
            <label class="visually-hidden" for="PasswordSignup-email">{{ 'templates.password.signup_email' | t }}</label>
            <input class="input" type="email" id="PasswordSignup-email" name="contact[email]" autocomplete="email" required placeholder="{{ 'templates.password.signup_email' | t }}">
            <button type="submit" class="button">{{ 'templates.password.signup_submit' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <details class="password__login">
      <summary class="link">{{ 'templates.password.enter_password' | t }}</summary>
      {%- form 'storefront_password', id: 'StorefrontPassword' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="password__row">
          <label class="visually-hidden" for="StorefrontPassword-input">{{ 'templates.password.password' | t }}</label>
          <input class="input" type="password" id="StorefrontPassword-input" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}">
          <button type="submit" class="button button--secondary">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="password__admin"><a class="link" href="/admin">{{ 'templates.password.admin_link' | t }}</a></p>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "main-password-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show email signup",
      "default": true
    }
  ]
}
{% endschema %}
