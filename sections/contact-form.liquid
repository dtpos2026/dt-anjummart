<div class="section section--tight-top">
  <div class="page-width page-width--narrow">
    <div class="card">
      <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
            {{ 'contact.form.error_heading' | t }}
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <div class="contact-form__row">
          <div class="field">
            <label for="ContactForm-name">{{ 'contact.form.name' | t }}</label>
            <input class="input" type="text" id="ContactForm-name" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>
          <div class="field">
            <label for="ContactForm-email">{{ 'contact.form.email' | t }} <span aria-hidden="true">*</span></label>
            <input class="input" type="email" id="ContactForm-email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
          </div>
        </div>
        <div class="field">
          <label for="ContactForm-phone">{{ 'contact.form.phone' | t }}</label>
          <input class="input" type="tel" id="ContactForm-phone" name="contact[phone]" autocomplete="tel" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
        </div>
        <div class="field">
          <label for="ContactForm-body">{{ 'contact.form.comment' | t }}</label>
          <textarea class="textarea" id="ContactForm-body" name="contact[body]" rows="6">{{ form.body }}</textarea>
        </div>
        <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "contact-form-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send us a message"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
