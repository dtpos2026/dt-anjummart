{{ 'home.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <section class="section section--tiles{% if section.settings.surface %} section--surface{% endif %}" aria-labelledby="TilesHeading-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section-header section-header--center">
          <div class="section-header__text">
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            <h2 id="TilesHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
            {%- if section.settings.subheading != blank -%}
              <p class="section-header__subheading">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <ul class="tiles tiles--{{ section.blocks.size | at_most: 4 }}" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign tile_title = block.settings.title | default: c.title | default: 'Collection'
            assign tile_url = c.url | default: routes.collections_url
            assign tile_image = block.settings.image
            assign art = block.settings.art
          -%}
          <li class="tiles__item" {{ block.shopify_attributes }}>
            <a class="tile" href="{{ tile_url }}">
              <span class="tile__media">
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 900',
                      sizes: '(min-width: 1320px) 420px, (min-width: 750px) 30vw, 92vw',
                      alt: ''
                  }}
                {%- elsif art != 'none' -%}
                  {%- assign art_file = 'tile-' | append: art | append: '.jpg' -%}
                  <img src="{{ art_file | asset_url }}" width="800" height="1000" alt="" loading="lazy" decoding="async">
                {%- elsif c.featured_image != blank -%}
                  {{
                    c.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 900',
                      sizes: '(min-width: 1320px) 420px, (min-width: 750px) 30vw, 92vw',
                      alt: ''
                  }}
                {%- endif -%}
              </span>
              <span class="tile__body">
                <span class="tile__title">{{ tile_title | escape }}</span>
                {%- if block.settings.subtitle != blank -%}
                  <span class="tile__subtitle">{{ block.settings.subtitle | escape }}</span>
                {%- endif -%}
                <span class="tile__cta">
                  {{- block.settings.cta | default: 'Shop now' | escape -}}
                  {% render 'icon', name: 'arrow-right' %}
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection tiles",
  "tag": "div",
  "class": "collection-tiles-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Light background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection name."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended 800 x 1000 px. Keep the bottom 22% calm: the title sits there."
        },
        {
          "type": "select",
          "id": "art",
          "label": "Built-in artwork",
          "info": "Used when no image is uploaded above. With none, the collection image is used.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "mens", "label": "Men's watches" },
            { "value": "womens", "label": "Women's watches" },
            { "value": "jewellery", "label": "Bridal jewellery" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
