<div class="account-page">
  <div class="page-width account-page__narrow">
    <div class="card">
      <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="contact-form__row">
          <div class="field">
            <label for="RegisterForm-FirstName">{{ 'customer.register.first_name' | t }}</label>
            <input class="input" type="text" name="customer[first_name]" id="RegisterForm-FirstName" autocomplete="given-name" value="{{ form.first_name }}">
          </div>
          <div class="field">
            <label for="RegisterForm-LastName">{{ 'customer.register.last_name' | t }}</label>
            <input class="input" type="text" name="customer[last_name]" id="RegisterForm-LastName" autocomplete="family-name" value="{{ form.last_name }}">
          </div>
        </div>
        <div class="field">
          <label for="RegisterForm-email">{{ 'customer.register.email' | t }}</label>
          <input class="input" type="email" name="customer[email]" id="RegisterForm-email" autocomplete="email" required value="{{ form.email }}">
        </div>
        <div class="field">
          <label for="RegisterForm-password">{{ 'customer.register.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="RegisterForm-password" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
        <p class="account-page__alt"><a class="link" href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a></p>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Customer register", "tag": "section", "class": "main-register-section", "settings": [] }
{% endschema %}
