{%- liquid
  assign terms = predictive_search.terms
  assign products = predictive_search.resources.products
  assign collections_found = predictive_search.resources.collections
  assign queries = predictive_search.resources.queries
-%}
{%- if predictive_search.performed -%}
  {%- if products.size == 0 and collections_found.size == 0 and queries.size == 0 -%}
    <p class="predictive-search__empty" aria-hidden="true">{{ 'search.no_results' | t: terms: terms }}</p>
  {%- else -%}
    {%- if queries.size > 0 -%}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictiveQueries">
        <h3 class="predictive-search__heading" id="PredictiveQueries">{{ 'search.suggestions' | t }}</h3>
        {%- for query in queries -%}
          <a class="predictive-search__query" href="{{ query.url }}" role="option" aria-selected="false">
            {% render 'icon', name: 'search' %}
            <span>{{ query.styled_text }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictiveProducts">
        <h3 class="predictive-search__heading" id="PredictiveProducts">{{ 'search.products' | t }}</h3>
        {%- for product in products -%}
          <a class="predictive-search__item" href="{{ product.url }}" role="option" aria-selected="false">
            {%- if product.featured_media -%}
              <span class="predictive-search__media">
                {{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                {% render 'image-watermark', context: 'thumb' %}
              </span>
            {%- else -%}
              <span class="predictive-search__thumb" aria-hidden="true"></span>
            {%- endif -%}
            <span>
              <span class="predictive-search__item-title">{{ product.title | escape }}</span>
              {%- if settings.predictive_search_show_price -%}
                <span class="predictive-search__item-meta">
                  {%- liquid
                    assign ps_cheapest = product.variants | sort: 'price' | first
                    assign ps_compare_at = ps_cheapest.compare_at_price | default: 0
                    assign ps_price = product.price | money
                    if product.price_varies
                      assign ps_price = 'products.product.price_from' | t: price: ps_price
                    endif
                  -%}
                  {%- if product.available == false -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- elsif ps_compare_at > product.price -%}
                    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
                    <span class="price-item--sale">{{ ps_price }}</span>
                    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                    <s>{{ ps_compare_at | money }}</s>
                  {%- else -%}
                    {{ ps_price }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if collections_found.size > 0 -%}
      <div class="predictive-search__group" role="group" aria-labelledby="PredictiveCollections">
        <h3 class="predictive-search__heading" id="PredictiveCollections">{{ 'search.collections' | t }}</h3>
        {%- for c in collections_found -%}
          <a class="predictive-search__query" href="{{ c.url }}" role="option" aria-selected="false">
            {% render 'icon', name: 'grid' %}
            <span>{{ c.title | escape }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  <a class="predictive-search__all" href="{{ routes.search_url }}?q={{ terms | url_encode }}&amp;options%5Bprefix%5D=last" role="option" aria-selected="false">
    <span>{{ 'search.view_all' | t: terms: terms }}</span>
    {% render 'icon', name: 'arrow-right' %}
  </a>
{%- endif -%}
