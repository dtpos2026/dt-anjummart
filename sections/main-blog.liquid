<div class="main-page">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        <li><span aria-current="page">{{ blog.title | escape }}</span></li>
      </ol>
    </nav>
    <h1>{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="article-grid" role="list">
          {%- for article in blog.articles -%}
            <li class="article-card">
              {%- if article.image -%}
                <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1384px) 425px, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: '' }}
                </a>
              {%- endif -%}
              <div class="article-card__body">
                <p class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="h3"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
                <a class="link-arrow" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} {% render 'icon', name: 'arrow-right' %}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state"><p>{{ 'blogs.empty' | t }}</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "main-blog-section",
  "settings": []
}
{% endschema %}
