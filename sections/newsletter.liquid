{{ 'home.css' | asset_url | stylesheet_tag }}

<section class="newsletter" aria-labelledby="Newsletter-{{ section.id }}">
  <div class="page-width">
    <div class="newsletter__panel">
      <div class="newsletter__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="newsletter__heading" id="Newsletter-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="newsletter__copy">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success newsletter__message" role="status">{{ section.settings.success_text | escape }}</p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error newsletter__message" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="newsletter__row">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ section.settings.placeholder | escape }}</label>
          <input
            class="input newsletter__input"
            type="email"
            id="NewsletterEmail-{{ section.id }}"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ section.settings.placeholder | escape }}"
          >
          <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses Shopify's own email sign-up. New subscribers appear under Customers with the tag newsletter."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Stay in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals, first"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Join our email list for new watches and jewellery."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email field label",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Thank-you message",
      "default": "Thank you for subscribing."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
