{%- liquid
  assign colors = 'blue,red,green' | split: ','
-%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}" id="categories" aria-labelledby="CategoriesHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="CategoriesHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a class="link-arrow" href="{{ routes.collections_url }}">
          {{- 'general.view_all' | t -}}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <ul class="category-list" role="list" style="--category-columns: {{ section.blocks.size | at_most: 6 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title | default: c.title | default: 'Category'
          assign url = c.url | default: routes.collections_url
          assign image = block.settings.image | default: c.featured_image
          assign color = block.settings.color
          if color == 'auto'
            assign color_index = forloop.index0 | modulo: 3
            assign color = colors[color_index]
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <div class="category-card">
            <div class="category-card__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 500, 600, 700',
                    sizes: '(min-width: 1100px) 260px, (min-width: 750px) 28vw, 42vw',
                    alt: ''
                }}
              {%- else -%}
                <div class="category-card__fallback category-card__fallback--{{ color }}">
                  {% render 'icon', name: block.settings.icon %}
                </div>
              {%- endif -%}
            </div>
            <div class="category-card__body">
              <div>
                <h3 class="category-card__title">
                  <a href="{{ url }}">{{ title | escape }}</a>
                </h3>
                {%- if section.settings.show_count and c.products_count > 0 -%}
                  <span class="category-card__count">{{ 'collections.products_count' | t: count: c.products_count }}</span>
                {%- endif -%}
              </div>
              <span class="category-card__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category cards",
  "tag": "div",
  "class": "category-cards-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find exactly what you love"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Light background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Uses the collection image or its first product image when empty."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "info": "Shown on a brand-colored tile when no image is available.",
          "options": [
            { "value": "watch", "label": "Watch" },
            { "value": "handbag", "label": "Handbag" },
            { "value": "jewellery", "label": "Jewellery" },
            { "value": "dress", "label": "Dress" },
            { "value": "shoe", "label": "Shoe" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "watch"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Fallback tile color",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "green", "label": "Green" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category cards",
      "blocks": [
        { "type": "category", "settings": { "icon": "watch" } },
        { "type": "category", "settings": { "icon": "handbag" } },
        { "type": "category", "settings": { "icon": "jewellery" } },
        { "type": "category", "settings": { "icon": "dress" } },
        { "type": "category", "settings": { "icon": "shoe" } }
      ]
    }
  ]
}
{% endschema %}
