{% layout none %}
{%- liquid
  assign initial_value = gift_card.initial_value | money
  assign balance_money = gift_card.balance | money
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value, shop: shop.name }}</title>
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="main-content gift-card">
      <div class="page-width page-width--narrow">
        <div class="gift-card__logo">{% render 'logo', height: 110 %}</div>
        <div class="card gift-card__card">
          <h1 class="h2">{{ 'gift_cards.issued.title' | t: value: initial_value, shop: shop.name }}</h1>
          <p class="gift-card__balance">
            {{ 'gift_cards.issued.balance' | t: balance: balance_money }}
          </p>
          {%- if gift_card.enabled == false -%}
            <p class="badge badge--soldout">{{ 'gift_cards.issued.disabled' | t }}</p>
          {%- elsif gift_card.expired -%}
            {%- assign expiry = gift_card.expires_on | date: '%B %e, %Y' -%}
            <p class="badge badge--soldout">{{ 'gift_cards.issued.expired' | t: expiry: expiry }}</p>
          {%- elsif gift_card.expires_on -%}
            {%- assign expiry = gift_card.expires_on | date: '%B %e, %Y' -%}
            <p class="text-muted">{{ 'gift_cards.issued.expires' | t: expiry: expiry }}</p>
          {%- endif -%}
          <p class="gift-card__code-label">{{ 'gift_cards.issued.code' | t }}</p>
          <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
          <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
          <div class="gift-card__actions">
            <button type="button" class="button button--secondary" data-copy="{{ gift_card.code }}" data-copied="{{ 'gift_cards.issued.copied' | t }}">
              {{- 'gift_cards.issued.copy' | t -}}
            </button>
            <a class="button" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
            {%- if gift_card.pass_url -%}
              <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
                <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy">
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </main>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) {
          new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120, imageAltText: {{ 'gift_cards.issued.code' | t | json }} });
        }
      });
    </script>
  </body>
</html>
